{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MinhHaDuong/ImperialDragonHarness/blob/main/adapters/pilot-support.schema.json",
  "title": "IDH adapter pilot evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice", "canonical_source", "versions", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "slice": {"type": "string", "minLength": 1},
    "canonical_source": {"type": "string", "minLength": 1},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/version"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness", "supported_versions", "probe_command",
        "unknown_version_behavior", "documentation_url", "release_url",
        "evidence_note"
      ],
      "properties": {
        "harness": {"enum": ["claude", "codex", "pi"]},
        "supported_versions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        },
        "probe_command": {"type": "string", "minLength": 1},
        "unknown_version_behavior": {"const": "refuse-support-check"},
        "documentation_url": {"type": "string", "format": "uri"},
        "release_url": {"type": "string", "format": "uri"},
        "evidence_note": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "harness", "harness_version", "assertion", "disposition",
        "evidence_kind", "test", "source_concept", "native_expression", "result"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "harness": {"enum": ["claude", "codex", "pi", "all"]},
        "harness_version": {"type": "string", "minLength": 1},
        "assertion": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["shared", "harness-specific", "manual-only"]},
        "evidence_kind": {"enum": ["static-test", "documentation", "manual-smoke"]},
        "test": {"type": "string", "minLength": 1},
        "source_concept": {"type": "string", "minLength": 1},
        "native_expression": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "pending"]}
      }
    }
  }
}
