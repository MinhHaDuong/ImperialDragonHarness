{
  "cleanupPeriodDays": 180,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "env": {
    "UV_ENV_FILE": "/home/haduong/.claude/.env",
    "BASH_ENV": "/home/haduong/.claude/scripts/bash-env.sh"
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Edit(~/.claude/settings.json)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Edit(~/.claude/skills/hunt/**)",
      "Edit(~/.claude/tickets/*.erg)",
      "Write(~/.claude/tickets/*.erg)",
      "Bash(uv sync *)",
      "Bash(git merge *)",
      "WebFetch(domain:tracingkieu.net)",
      "WebFetch(domain:minh.haduong.com)",
      "Bash(grep -v \"^[[:space:]]*$\")",
      "Bash(grep -o 'dong2[67][0-9][0-9].*$')",
      "Bash(python3 -c ' *)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix remote -v)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix config --list)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix fetch --dry-run)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix status -sb)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix worktree list)",
      "Read(//home/haduong/data/projets/chemin-de-voix/corpus/**)",
      "Bash(uv run *)",
      "Read(//mnt/snapshots/**)",
      "Read(//home/haduong/CNRS/projets/actifs/chemin-de-voix/tickets/**)",
      "Read(//tmp/**)",
      "Bash(xargs ls *)",
      "Read(//home/haduong/CNRS/projets/actifs/chemin-de-voix/**)",
      "Read(//home/haduong/data/cache/huggingface/hub/models--unsloth--qwen3-8b-unsloth-bnb-4bit/blobs/**)",
      "Bash(grep -vE \"^\\\\s*$\")",
      "Bash(ssh padme ' *)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "Bash(rtk ls *)",
      "Read(//home/haduong/CNRS/papiers/actif/AEDIST-technical-report/slides/manuscript/**)",
      "Bash(rtk read *)",
      "WebSearch",
      "Bash(pandoc --version)",
      "Read(//home/haduong/CNRS/papiers/actif/AEDIST-technical-report/**)",
      "Bash(rtk git *)",
      "Bash(rtk grep *)",
      "Bash(~/.claude/skills/merge/erg-pr-merge:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/haduong/CNRS/projets/actifs/chemin-de-voix",
      "/home/haduong/data/projets/chemin-de-voix/corpus",
      "/tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/on-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/on-end.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/knowledge_hints.py prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-destructive-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-cd-primary-repo.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-worktree-identity.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-commit-on-main.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash(gh pr merge*)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/block-pr-merge-in-worktree.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterWorktree|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-enterworktree-parked-cwd.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash(git worktree remove*)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/guard-worktree-remove-wip.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/pretooluse-worktree-path-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/inject_rule_on_edit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/lint-on-edit.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true
}
