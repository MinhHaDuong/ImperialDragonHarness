{
  "cleanupPeriodDays": 180,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.idh/scripts/statusline.sh"
  },
  "env": {
    "UV_ENV_FILE": "/home/haduong/.idh/.env",
    "BASH_ENV": "/home/haduong/.idh/scripts/bash-env.sh"
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Edit(~/.claude/settings.json)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Edit(~/.idh/skills/hunt/**)",
      "Edit(~/.idh/tickets/*.erg)",
      "Bash(uv sync *)",
      "Bash(git merge *)",
      "WebFetch(domain:tracingkieu.net)",
      "WebFetch(domain:minh.haduong.com)",
      "Bash(grep -v \"^[[:space:]]*$\")",
      "Bash(grep -o 'dong2[67][0-9][0-9].*$')",
      "Bash(python3 -c ' *)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix remote -v)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix config --list)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix fetch --dry-run)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix status -sb)",
      "Bash(git -C /home/haduong/CNRS/projets/actifs/chemin-de-voix worktree list)",
      "Read(//home/haduong/data/projets/chemin-de-voix/corpus/**)",
      "Bash(uv run *)",
      "Read(//mnt/snapshots/**)",
      "Read(//tmp/**)",
      "Bash(xargs ls *)",
      "Read(//home/haduong/CNRS/projets/actifs/chemin-de-voix/**)",
      "Read(//home/haduong/data/cache/huggingface/hub/models--unsloth--qwen3-8b-unsloth-bnb-4bit/blobs/**)",
      "Bash(grep -vE \"^\\\\s*$\")",
      "Bash(ssh padme ' *)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "Bash(rtk ls *)",
      "Bash(rtk read *)",
      "WebSearch",
      "Bash(pandoc --version)",
      "Read(//home/haduong/CNRS/papiers/actif/AEDIST-technical-report/**)",
      "Bash(rtk git *)",
      "Bash(rtk grep *)",
      "Bash(~/.idh/skills/merge/erg-pr-merge:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/haduong/CNRS/projets/actifs/chemin-de-voix",
      "/home/haduong/data/projets/chemin-de-voix/corpus",
      "/tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.idh/scripts/on-start.sh\" ] || { echo \"IDH: ~/.idh/scripts/on-start.sh is missing or not executable, so this hook cannot run. Restore the checkout at ~/.idh from a plain terminal outside Claude/Codex, then relaunch\" >&2; exit 2; }; exec \"$HOME/.idh/scripts/on-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.idh/scripts/on-end.sh\" ] || { echo \"IDH: ~/.idh/scripts/on-end.sh is missing or not executable, so this hook cannot run. Restore the checkout at ~/.idh from a plain terminal outside Claude/Codex, then relaunch\" >&2; exit 2; }; exec \"$HOME/.idh/scripts/on-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.idh/scripts/guard-destructive-bash.sh\" ] || { echo \"IDH: ~/.idh/scripts/guard-destructive-bash.sh is missing or not executable, so this hook cannot run. Restore the checkout at ~/.idh from a plain terminal outside Claude/Codex, then relaunch\" >&2; exit 2; }; exec \"$HOME/.idh/scripts/guard-destructive-bash.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true
}
