{
  "cleanupPeriodDays": 180,
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.local/bin/idh-hook\" statusline.sh"
  },
  "env": {
    "BASH_ENV": "$HOME/.local/lib/idh/bash-env.sh"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "EnterWorktree",
      "ExitWorktree",
      "Bash",
      "Read(//mnt/snapshots/**)",
      "WebSearch",
      "WebFetch(domain:minh.haduong.com)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "enabledPlugins": {},
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true
}
