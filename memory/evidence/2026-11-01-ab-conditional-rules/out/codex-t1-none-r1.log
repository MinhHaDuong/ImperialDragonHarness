import subprocess
import sys
import tempfile
import unittest
from pathlib import Path


class TemperatureCLITest(unittest.TestCase):
    def test_reports_statistics_and_first_date_of_tied_maximum(self):
        with tempfile.TemporaryDirectory() as directory:
            csv_path = Path(directory) / "temperatures.csv"
            csv_path.write_text(
                "date,temp_c\n"
                "2026-01-01,-5\n"
                "2026-01-02,10\n"
                "2026-01-03,5\n"
                "2026-01-04,10\n",
                encoding="utf-8",
            )
            result = subprocess.run(
                [
                    sys.executable,
                    str(Path(__file__).with_name("temperatures.py")),
                    str(csv_path),
                ],
                capture_output=True,
                text=True,
                encoding="utf-8",
                check=True,
            )

        self.assertEqual(
            result.stdout,
            "Mean: 5.00 °C\n"
            "Minimum: -5.00 °C\n"
            "Maximum: 10.00 °C\n"
            "Date of maximum: 2026-01-02\n",
        )


if __name__ == "__main__":
    unittest.main()
