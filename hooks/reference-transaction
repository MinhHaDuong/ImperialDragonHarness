#!/bin/sh
# --- main-update-guard --- (ticket 1157, tracker 1045)
# Journals every update of refs/heads/main and, in enforce mode only, refuses
# one that is not a gated merge. git runs this hook for every ref transaction
# (commit, fetch, update-ref, branch -f, reset, rebase, linked worktrees), and
# `--no-verify` does not skip it. A client that overrides core.hooksPath does:
# the daily audit (scripts/main_sweep.py) exists for that case.
#
# Mode: `git config idh.mainGuard`
#   warn    (default, also any unknown value) journal; a non-gated update gets
#           a stderr warning and goes through
#   enforce journal; a non-gated update is refused at the `prepared` phase
#   off     journal only
#
# After-merge start (ticket 1265): once a move of main is committed, and the
# new tip carries .merge-gate.json, the hook starts
# `python3 scripts/merge-gate.py run-after --open-ticket --ref main` detached
# (log: <git-common-dir>/idh/after-merge.log). Independent of idh.mainGuard,
# `off` included; `git config idh.afterMerge off` disables it. The runner is
# the primary checkout's, else $IDH_ROOT's, else the one beside this hook.
#
# A gated update of main is one of:
#   on-origin    the new tip is origin/main (as a `fetch` transaction may set
#                it: `fetch --atomic origin main:main`; from any other command
#                only the origin/main already on disk counts), or a fast-forward to a
#                commit already on origin/main, or a fast-forward to the main
#                tip this worktree just fetched from origin (FETCH_HEAD: a
#                plain `fetch origin main:main` moves main in a transaction of
#                its own, before origin/main). Covers scripts/sync-local-main.sh,
#                `git pull` and the forge's merges coming home.
#   gate-record  the new tip is a two-parent merge whose first parent is the
#                current main, whose tree is that of the candidate rebuilt
#                from its parents by scripts/merge-gate.py, and whose
#                candidate carries a passing gate record (refs/notes/gate,
#                written by ticket 1156's merge gate) for the declared
#                before-merge set (ticket 1245; merge-gate.py `check` decides
#                which records it accepts).
# Everything else (a local commit on main, a reset, branch -f, a deletion) is
# not gated, with one exception: git's own `pack-refs` (what `git gc` runs;
# ticket 1268). It writes main into packed-refs (a transaction `0 -> value`,
# a no-op create when value is the current main) and then prunes the loose
# ref (`value -> 0`, which reads as a deletion). Both are journaled as
# `pack-refs`, action `allowed`, in every mode, and start no after-merge run.
# The prune is recognised on state and argv together: old == current == the
# refs/heads/main line of packed-refs, and the parent command is `git
# [options] pack-refs`. State alone is not enough (`branch -D main` on a
# packed main looks the same); argv alone is not either (`-m pack-refs`
# spoofs a word match), hence the anchoring on the subcommand position.
# One deletion cannot be refused: `delete main <old>` through
# `update-ref --stdin` reaches the hook exactly as a `verify` does; it is
# journaled and warned about once committed.
#
# The journal never blocks: every journal step swallows its own errors, and
# only an enforce-mode refusal exits non-zero. Journal file, shared by all
# worktrees: $(git rev-parse --git-common-dir)/idh/main-journal.jsonl
#
# The guard is POSIX sh, git and /proc or ps only: no agent runtime is
# involved. Only the after-merge start launches Python, detached.
# No `set -e` on purpose: a failing journal step must not turn into a
# refused ref update (tests/test_main_guard_hook.py pins this).

phase=$1
MAIN_REF=refs/heads/main
ORIGIN_REF=refs/remotes/origin/main
GATE_NOTES_REF=refs/notes/gate   # NOTES_REF of scripts/merge-gate.py
ZERO=0000000000000000000000000000000000000000

main_updates=""
origin_new=""
while read -r old new ref; do
    case "$ref" in
        "$MAIN_REF") main_updates="$main_updates$old $new
" ;;
        "$ORIGIN_REF") origin_new=$new ;;
    esac
done
[ -n "$main_updates" ] || exit 0

# The git command that runs this transaction (the hook's parent), padded with
# spaces for word matching. Read for two facts only: whether the transaction
# came from `fetch` (only then is an origin/main value inside the same
# transaction trusted) and whether it came from `update-ref --stdin` (where a
# `verify` and a `delete` with an expected old value reach this hook alike).
if [ -r "/proc/$PPID/cmdline" ]; then
    git_argv=" $(tr '\000' ' ' < "/proc/$PPID/cmdline" 2>/dev/null) "
else
    git_argv=" $(ps -o args= -p "$PPID" 2>/dev/null) "
fi
# The subcommand of that command: `git [global options] <sub> ...`, argv0
# required to be `git` (under `gc` the parent is the child `git pack-refs`, argv0 its
# libexec path). Words are the NUL-separated argv entries, never re-split: a
# newline inside a word is masked (\001) before NUL becomes the separator, so
# `-c $'a=b\npack-refs'` stays one word. Only git's own global options are
# stepped over, each with its exact arity (git 2.43); an unknown option, or a
# parent that is not readable from /proc (the `ps` fallback cannot tell words
# apart), leaves git_sub empty: not pack-refs.
git_sub=""
if [ -r "/proc/$PPID/cmdline" ]; then
    git_words=$(tr '\n' '\001' < "/proc/$PPID/cmdline" 2>/dev/null | tr '\000' '\n')
    skip=0
    first=1
    while IFS= read -r word; do
        if [ "$first" = 1 ]; then
            # Only a process that presents itself as `git` (basename of argv0,
            # `git-pack-refs`-style names and `exec -a` aliases excluded).
            [ "${word##*/}" = git ] || break
            first=0
            continue
        fi
        if [ "$skip" = 1 ]; then skip=0; continue; fi
        case "$word" in
            -c|-C|--git-dir|--work-tree|--namespace|--super-prefix|--config-env|--attr-source|--shallow-file) skip=1 ;;
            --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|--attr-source=*|--exec-path=*) ;;
            -p|--paginate|-P|--no-pager|--no-replace-objects|--no-lazy-fetch|--no-optional-locks|--no-advice) ;;
            --bare|--exec-path|--html-path|--man-path|--info-path) ;;
            --literal-pathspecs|--no-literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs) ;;
            ""|-*) break ;;
            *) git_sub=$word; break ;;
        esac
    done <<EOF_WORDS
$git_words
EOF_WORDS
fi
case "$git_argv" in *" fetch "*) ;; *) origin_new="" ;; esac
case "$git_argv" in *" --stdin "*) stdin_tx=1 ;; *) stdin_tx=0 ;; esac

# The gate receipt of merge $1, through scripts/merge-gate.py beside hooks/
# (the one builder of the candidate and reader of the record; ticket 1179):
# exactly two parents, the tree of the candidate rebuilt from them, and a
# passing record on that candidate. A merge made with other metadata than the
# candidate's (a plain `git merge --no-ff`) passes; an edited tree, an octopus
# or a failing record does not. Without the script nothing passes this way.
gate_record_present() {
    git rev-parse -q --verify "$1^3" >/dev/null 2>&1 && return 1
    gate_tool="$(dirname "$0")/../scripts/merge-gate.py"
    cand=$(python3 "$gate_tool" candidate --base "$1^1" --head "$1^2" 2>/dev/null) || return 1
    [ "$(git rev-parse -q --verify "$cand^{tree}")" = "$(git rev-parse -q --verify "$1^{tree}")" ] || return 1
    python3 "$gate_tool" check --no-fetch --base "$1^1" --head "$1^2" >/dev/null 2>&1
}

# The url as FETCH_HEAD prints it: no user@, no trailing / or .git.
norm_url() {
    printf '%s' "$1" | sed -e 's|^\([a-z+]*://\)\{0,1\}[^@/]*@|\1|' -e 's|/$||' -e 's|\.git$||'
}

# $1 is the main tip this worktree last fetched from origin.
fetched_from_origin() {
    url=$(git remote get-url origin 2>/dev/null) || return 1
    want="branch 'main' of $(norm_url "$url")"
    fh=$(git rev-parse --git-path FETCH_HEAD 2>/dev/null) || return 1
    [ -r "$fh" ] || return 1
    # Fields are tab-separated and the middle one is often empty; a tab in
    # IFS is whitespace and would merge it away, so split by hand.
    while IFS= read -r line; do
        sha=${line%%	*}
        desc=${line##*	}
        if [ "$sha" = "$1" ]; then
            have="branch 'main' of $(norm_url "${desc#"branch 'main' of "}")"
            [ "$have" = "$want" ] && return 0
        fi
    done < "$fh"
    return 1
}

is_zero() {
    case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}

json_str() {
    printf '%s' "$1" | tr '\000-\037' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Command lines of the process chain, from git (the hook's parent) upward.
procs_json() {
    pid=$PPID
    depth=0
    out=""
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 16 ]; do
        if [ -r "/proc/$pid/cmdline" ]; then
            cmd=$(tr '\000' ' ' < "/proc/$pid/cmdline")
            ppid=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status")
        else
            cmd=$(ps -o args= -p "$pid")
            ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
        fi
        [ -n "$out" ] && out="$out,"
        out="$out{\"pid\":$pid,\"cmd\":\"$(json_str "$cmd")\"}"
        pid=$ppid
        depth=$((depth + 1))
    done
    printf '[%s]' "$out"
}

journal() {
    # $1 declared old, $2 actual current, $3 new, $4 decision, $5 action
    common=$(git rev-parse --path-format=absolute --git-common-dir) || return 0
    mkdir -p "$common/idh" || return 0
    line="{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"phase\":\"$(json_str "$phase")\""
    line="$line,\"ref\":\"$MAIN_REF\",\"old\":\"$1\",\"current\":\"$2\",\"new\":\"$3\""
    line="$line,\"mode\":\"$(json_str "$mode")\",\"decision\":\"$4\",\"action\":\"$5\""
    line="$line,\"user\":\"$(json_str "$(id -un)")\",\"uid\":\"$(id -u)\""
    line="$line,\"host\":\"$(json_str "$(uname -n)")\",\"cwd\":\"$(json_str "$PWD")\""
    line="$line,\"git_ident\":\"$(json_str "$(git var GIT_COMMITTER_IDENT)")\""
    line="$line,\"procs\":$(procs_json)}"
    printf '%s\n' "$line" >> "$common/idh/main-journal.jsonl"
}

# The refs/heads/main value in packed-refs; empty when the file is absent or
# has no such line (a reftable repository: nothing matches, so nothing passes).
packed_main() {
    pc=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    [ -r "$pc/packed-refs" ] || return 0
    while read -r psha pref; do
        if [ "$pref" = "$MAIN_REF" ]; then printf '%s' "$psha"; return 0; fi
    done < "$pc/packed-refs"
    return 0
}

# Git's own pack-refs (ticket 1268): $1 declared old, $2 actual current, $3 new.
# Succeeds for the pack write (a no-op create of the current value, from any
# caller) and for the prune (old == current == packed, under `git pack-refs`).
is_pack_refs() {
    if is_zero "$1" && ! is_zero "$2" && [ "$3" = "$2" ]; then return 0; fi
    if [ "$git_sub" = pack-refs ] && is_zero "$3" && ! is_zero "$1" &&
       [ "$1" = "$2" ] && [ "$(packed_main)" = "$1" ]; then return 0; fi
    return 1
}

classify() {
    # $1 actual current, $2 new; prints on-origin | gate-record | not-gated
    if is_zero "$2"; then echo not-gated; return; fi
    tip=$origin_new
    [ -n "$tip" ] || tip=$(git rev-parse -q --verify "$ORIGIN_REF")
    if [ -n "$tip" ] && ! is_zero "$tip"; then
        if [ "$2" = "$tip" ]; then echo on-origin; return; fi
        if git merge-base --is-ancestor "$2" "$tip" 2>/dev/null &&
           { is_zero "$1" || git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }; then
            echo on-origin; return
        fi
    fi
    if fetched_from_origin "$2" &&
       { is_zero "$1" || git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }; then
        echo on-origin; return
    fi
    if gate_record_present "$2" &&
       git rev-parse -q --verify "$2^2" >/dev/null 2>&1 &&
       [ "$(git rev-parse -q --verify "$2^1" 2>/dev/null)" = "$1" ]; then
        echo gate-record; return
    fi
    echo not-gated
}

# --- after-merge start --- (ticket 1265, tracker 1226)
# Once a move of main is committed, the full check set runs on the new tip:
# `merge-gate.py run-after --open-ticket --ref main` (skills/merge/SKILL.md
# step 9), started here so that no landing path (scripts/raid_land.py, the
# merge recipe by hand, sync-local-main.sh after a forge merge) has to remember
# it. Only for a tip whose tree carries .merge-gate.json, and not when
# `git config idh.afterMerge` is `off`. The runner is the primary checkout's
# scripts/merge-gate.py (it outlives a linked worktree that a landing removes
# right after), else $IDH_ROOT's, else the one beside this hook. It starts in its own session,
# from the shared git directory, with no inherited git repository variables
# and none of git's descriptors: the update never waits on it, and a runner
# that cannot start costs the update nothing. Its flock dedupes concurrent
# starts, and it skips a tip that already carries an after-merge record.
start_after_merge() {
    [ "$(git config --get idh.afterMerge 2>/dev/null)" = off ] && return 0
    git cat-file -e "$1:.merge-gate.json" 2>/dev/null || return 0
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    runner=""
    case "$common" in */.git) runner="${common%/.git}/scripts/merge-gate.py" ;; esac
    [ -f "$runner" ] || runner="${IDH_ROOT:-/nonexistent}/scripts/merge-gate.py"
    [ -f "$runner" ] || runner="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)/scripts/merge-gate.py"
    [ -f "$runner" ] || return 0
    mkdir -p "$common/idh" 2>/dev/null || return 0
    detach=""
    command -v setsid >/dev/null 2>&1 && detach=setsid
    (
        # shellcheck disable=SC2046  # one word per variable name is the intent
        unset $(git rev-parse --local-env-vars 2>/dev/null)
        GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT
        cd "$common" || exit 0
        $detach nohup python3 "$runner" run-after --open-ticket --ref main \
            </dev/null >>"$common/idh/after-merge.log" 2>&1 &
    ) </dev/null >/dev/null 2>&1
    return 0
}

if [ "$phase" = committed ]; then
    moved=0
    while read -r old new; do
        [ -n "$new" ] && [ "$old" != "$new" ] && ! is_zero "$new" || continue
        # pack-refs' pack write (`0 -> value`) restates main, it does not move it
        [ "$git_sub" = pack-refs ] && is_zero "$old" && continue
        moved=1
    done <<EOF
$main_updates
EOF
    tip=$(git rev-parse -q --verify "$MAIN_REF" 2>/dev/null)
    [ "$moved" = 1 ] && [ -n "$tip" ] && start_after_merge "$tip" >/dev/null 2>&1
fi
# --- after-merge start ---

mode=$(git config --get idh.mainGuard 2>/dev/null)
case "$mode" in enforce|warn|off) ;; *) mode=warn ;; esac

status=0
current=$(git rev-parse -q --verify "$MAIN_REF" 2>/dev/null) || current=$ZERO
printf '%s' "$main_updates" | {
    while read -r old new; do
        [ "$old" = "$new" ] && ! is_zero "$new" && continue
        decision=""
        action=""
        if is_pack_refs "$old" "$current" "$new"; then
            ( journal "$old" "$current" "$new" pack-refs allowed ) >/dev/null 2>&1
            continue
        fi
        if [ "$stdin_tx" = 1 ] && is_zero "$new" && ! is_zero "$old"; then
            # `update-ref --stdin`: `verify main <old>` and `delete main <old>`
            # both arrive as "<old> <zero>". A verify changes nothing, so
            # stay out of the way at `prepared`; after the fact, main still
            # existing means it was a verify. A deletion is journaled and
            # warned about, but could not be refused.
            [ "$phase" = committed ] && is_zero "$current" || continue
            decision=deleted-unrefusable
            [ "$mode" = off ] && action=allowed || action=warned
            ( journal "$old" "$current" "$new" "$decision" "$action" ) >/dev/null 2>&1
            [ "$action" = warned ] &&
                echo "main-guard: warning: $MAIN_REF was deleted through update-ref --stdin; journaled, could not be refused." >&2
            continue
        fi
        if [ "$phase" = prepared ]; then
            decision=$(classify "$current" "$new" 2>/dev/null)
            [ -n "$decision" ] || decision=not-gated
            action=allowed
            if [ "$decision" = not-gated ]; then
                case "$mode" in
                    enforce) action=refused ;;
                    warn) action=warned ;;
                esac
            fi
        fi
        ( journal "$old" "$current" "$new" "$decision" "$action" ) >/dev/null 2>&1
        case "$action" in
            refused)
                echo "main-guard: refused: update of $MAIN_REF ${current%"${current#???????}"}..${new%"${new#???????}"} is not a gated merge (idh.mainGuard=enforce)." >&2
                echo "main-guard: main moves only to origin/main or to a merge carrying a gate record ($GATE_NOTES_REF). Land it via branch + PR." >&2
                status=1 ;;
            warned)
                echo "main-guard: warning: update of $MAIN_REF ${current%"${current#???????}"}..${new%"${new#???????}"} is not a gated merge; journaled (idh.mainGuard=warn)." >&2 ;;
        esac
    done
    exit $status
}
# --- main-update-guard ---
