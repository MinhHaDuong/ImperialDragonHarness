#!/bin/sh
# --- main-branch-guard ---
# Refuse a direct commit on `main` in the PRIMARY checkout. Commits on a
# branch are fine; commits from any worktree (raid/agent worktrees) are fine
# even on main, because worktree branches are the normal flow there.
#
# Discriminator: a linked worktree's per-worktree git dir (--git-dir) differs
# from the primary repo's shared git dir (--git-common-dir). In the primary
# checkout the two are the SAME path; in any linked worktree they differ.
#   - primary checkout: git_dir == common_dir  -> guard may fire
#   - linked worktree:  git_dir != common_dir  -> guard stays silent
# (Both are resolved to absolute paths first; --git-common-dir can be relative,
#  e.g. ".git", which would otherwise never compare equal to the absolute
#  --absolute-git-dir and silently disable the guard everywhere.)
#
# Skipped when: CI=true (or GITHUB_ACTIONS), a rebase/merge/cherry-pick is in
# progress (those replay commits and must not be blocked), or the operator
# sets ALLOW_MAIN_COMMIT=1 for a deliberate primary-checkout main commit.
if [ "${ALLOW_MAIN_COMMIT:-}" != "1" ] && [ -z "${CI:-}" ] && [ -z "${GITHUB_ACTIONS:-}" ]; then
    git_dir=$(git rev-parse --absolute-git-dir)
    if [ ! -e "$git_dir/MERGE_HEAD" ] && \
       [ ! -d "$git_dir/rebase-merge" ] && \
       [ ! -d "$git_dir/rebase-apply" ] && \
       [ ! -e "$git_dir/CHERRY_PICK_HEAD" ]; then
        current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
        if [ "$current_branch" = "main" ]; then
            # Resolve the shared (common) git dir to an absolute path.
            common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
            case "$common_dir" in
                /*) ;;
                "") ;;
                *)  common_dir="$(cd "$common_dir" 2>/dev/null && pwd)" ;;
            esac
            if [ -n "$common_dir" ] && [ "$git_dir" = "$common_dir" ]; then
                echo "ERROR: refusing to commit directly on main in the primary checkout." >&2
                echo "Everything lands via branch + PR. Switch to a branch first:" >&2
                echo "    git switch -c <branch>" >&2
                echo "Override (deliberate cases only): ALLOW_MAIN_COMMIT=1 git commit ..." >&2
                exit 1
            fi
        fi
    fi
fi
# --- main-branch-guard ---

# --- erg-source-guard ---
# Reject any staged changes under tickets/tools/go/ — erg source is read-only
# in IDH. All edits must go to the git-erg project.
erg_source=$(git diff --cached --diff-filter=d --name-only | grep '^tickets/tools/go/' || true)
if [ -n "$erg_source" ]; then
    echo "ERROR: erg source is read-only in IDH — commit changes to git-erg project instead" >&2
    echo "Rejected files:" >&2
    echo "$erg_source" >&2
    exit 1
fi
# --- erg-source-guard ---

# --- skills-catalog-guard ---
# When any skills/*/SKILL.md is staged, regenerate README.md skills catalog.
skills_changed=$(git diff --cached --name-only | grep '^skills/.*/SKILL\.md$' || true)
if [ -n "$skills_changed" ]; then
    if ! make skills-catalog; then
        echo "ERROR: make skills-catalog failed — commit aborted" >&2
        exit 1
    fi
    git add README.md
fi
# --- skills-catalog-guard ---

# --- git-erg: begin managed block ---
# Pre-commit hook fragment for git-erg ticket validation.
# The install script appends this between "# --- git-erg ---" markers,
# composing safely with any existing pre-commit hook.
# To install manually, append everything below the shebang to your hook.

# Validate .erg files (if any are staged)
erg_files=$(git diff --cached --name-only | grep '\.erg$' || true)
if [ -n "$erg_files" ]; then
    erg_bin="${ERG:-tickets/erg}"
    if [ -x "$erg_bin" ]; then
        if ! "$erg_bin" check tickets/; then
            echo "ERROR: Ticket validation failed. Fix errors above." >&2
            exit 1
        fi
    else
        echo "ERROR: erg binary not found. Refresh the vendored binary: git pull (tickets/erg is committed), or build from git-erg source." >&2
        exit 1
    fi
fi
# --- git-erg: end managed block ---
