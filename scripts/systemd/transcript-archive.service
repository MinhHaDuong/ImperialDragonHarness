[Unit]
Description=Compress runtime transcripts into the agent-sessions store (tickets 1383, 1391)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.agents/scripts/transcript_archive.py
StandardOutput=journal
StandardError=journal
# The first run compresses the whole backlog (about 9 GB raw on padme).
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
