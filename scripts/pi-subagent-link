#!/usr/bin/env bash
# Link the managed release's subagent example, falling back to the package
# containing the actual Pi executable on PATH (including npm-global installs).
# Idempotent; run after an upgrade. Missing/incomplete sources fail visibly.
set -euo pipefail

pi_home="${PI_HOME:-$HOME/.pi/agent}"
marker="$pi_home/install/current-version"
src=""
managed_attempt="$marker (unreadable)"

has_modules() {
  [ -f "$1/index.ts" ] && [ -r "$1/index.ts" ] &&
    [ -f "$1/agents.ts" ] && [ -r "$1/agents.ts" ]
}

if [ -r "$marker" ]; then
  version="$(tr -d '[:space:]' < "$marker")"
  candidate="$pi_home/install/releases/$version/node_modules/@earendil-works/pi-coding-agent/examples/extensions/subagent"
  managed_attempt="$marker -> $candidate"
  if has_modules "$candidate"; then
    src="$candidate"
  fi
fi

executable_attempt="pi on PATH (not found)"
if [ -z "$src" ]; then
  executable="$(command -v pi || true)"
  if [ -n "$executable" ]; then
    resolved="$(readlink -f "$executable" || true)"
    executable_attempt="pi on PATH: $executable -> ${resolved:-unresolved}"
    if [ -n "$resolved" ]; then
      package="$(dirname "$resolved")"
      while [ "$package" != / ]; do
        parent="$(dirname "$package")"
        if [ "${package##*/}" = pi-coding-agent ] &&
          [ "${parent##*/}" = @earendil-works ]; then
          candidate="$package/examples/extensions/subagent"
          executable_attempt="$executable_attempt -> $candidate"
          if has_modules "$candidate"; then
            src="$candidate"
          fi
          break
        fi
        package="$parent"
      done
    fi
  fi
fi

if [ -z "$src" ]; then
  echo "pi-subagent-link: no complete subagent example; tried managed $managed_attempt; executable $executable_attempt" >&2
  exit 1
fi

dest="$pi_home/extensions/subagent"
mkdir -p "$dest"
ln -sfn "$src/agents.ts" "$dest/agents.ts"

# The example spawns every child with --no-session, so subagent runs leave no transcript. Install a
# copy whose flag names the archive spool instead (ticket 1383; path convention
# scripts/transcript_spool.py: <archive>/spool/<host>/pi; default root from `transcript_spool.py root`). Never write through the old symlink.
root="${IDH_ARCHIVE_ROOT:-$(python3 "$(dirname "$(readlink -f "$0")")/transcript_spool.py" root)}"
spool="$root/spool/${HOSTNAME%%.*}/pi"
flag='"--no-session"'
IFS= read -r -d '' body < "$src/index.ts" || true
case "$spool" in *[\\\"\&$'\n']*) spool="" ;; esac
if [ -z "$spool" ] || [[ "$body" != *"$flag"* ]]; then
  ln -sfn "$src/index.ts" "$dest/index.ts"
  echo "pi-subagent-link: $src/index.ts has no $flag to patch (or the spool path is unsafe); subagent children keep no session file" >&2
  exit 1
fi
mkdir -p "$spool"
rm -f "$dest/index.ts"
printf '%s' "${body//"$flag"/\"--session-dir\", \"$spool\"}" > "$dest/index.ts"
