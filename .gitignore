# Track only the harness — ignore everything else
*

# Harness components
!.gitignore
!.gitattributes
!pyproject.toml
!uv.lock
!.ruff.toml
!.merge-gate.json
!README.md
!INSTALL.md
!CONTRIBUTING.md
!skills-catalog.md
!STATE.md
!ROADMAP.md
!AGENTS.md
!RTK.md
!.github/
!.github/**
!skills/
!skills/**

# Private skills live in the local overlay (~/.config/harness/private/),
# never in this public repo — ignore their symlinks.
skills/email
skills/infrastructure
skills/directory
!scripts/
!scripts/**
!ci-local/
!ci-local/**
!bin/
!bin/**
!commands/
!commands/**
!design/
!design/**
!memory/
!memory/**
# Health journal (ticket 1334): one checkup record per harness-doctor visit.
!health/
!health/journal.jsonl
memory/.provenance.lock

# Per-project agent memory exports are not published (ticket 1480).
projects/

!tickets/
!tickets/**
tickets/tools/go/*.test
!rules/
!rules/**
!agents/
!agents/**
!profiles/
!profiles/**

# Makefile for harness targets (skills catalog, checks, etc.)
!Makefile

# Git hooks — tracked so all machines pick them up via on-start-sync.sh
!hooks/
!hooks/**

# settings.shared.json: canonical shared config (hooks, env, permissions) — tracked
# settings.json: live per-machine file (CLI writes model/effortLevel into it) — untracked;
#   bootstrapped from and re-aligned to settings.shared.json by hand
# settings.local.json: machine-specific permissions — gitignored
!settings.shared.json
!tests/
!tests/**

# Adapters (ticket 0800 family). The Claude Code adapter ships inert; its
# activation symlink is created at runtime by scripts/adapter-claude-code-activate.sh
# and must not be committed -- committing it would auto-load the plugin on merge,
# double-firing every hook against the live settings.json copy (ticket 0887).
!adapters/
!adapters/**
skills/claude-code

# Python build artefacts inside whitelisted dirs. Last on purpose: a
# re-inclusion below these lines wins over them, which is how adapters/
# quietly started offering its __pycache__ for commit once it held python
# (ticket 0802).
**/__pycache__/
*.pyc

# Populated by the client at run time from the account's skill sync (ticket 0950); never shipped.
skills/synced/

